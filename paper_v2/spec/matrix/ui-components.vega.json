          "view": "API /api/graph.json"
        }
      ]
    },
    {
      "name": "views",
      "source": "stages",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "view"
          ],
          "fields": [
            "index",
            "index"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "minIdx",
            "maxIdx"
          ]
        }
      ]
    },
    {
      "name": "viewBoundaries",
      "source": "views",
      "transform": [
        {
          "type": "formula",
          "expr": "[datum.minIdx, datum.maxIdx + 1]",
          "as": "indices"
        },
        {
          "type": "flatten",
          "fields": [
            "indices"
          ]
        },
        {
          "type": "aggregate",
          "groupby": [
            "indices"
          ]
        }
      ]
    },
    {
      "name": "stageBoundaries",
      "values": [
        {
          "index": 0
        },
        {
