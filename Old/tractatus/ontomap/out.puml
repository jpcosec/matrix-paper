[Supervisor LLM] --> [ContextPill] : {what: informs}, {how: writes_markdown}, {why: zero_context_sufficiency}
[Supervisor LLM] --> [DesignSpec] : {what: informs}, {how: conceptual_design}, {why: blueprinting}
[Supervisor LLM] --> [Evidence.json] : {what: validates}, {how: parses_trace}, {why: quality_gate}
[Supervisor LLM] --> [SourceCode] : {what: validates}, {how: writes_e2e_tests}, {why: phase_validation}
[Task] --> [ContextPill] : {what: refsById}, {why: scope_isolation}
[Task] --> [SourceCode] : {what: transitionsTo}, {when: ExecPhase}, {how: write_code}

